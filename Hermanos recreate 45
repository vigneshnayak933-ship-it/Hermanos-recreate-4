-- 4. Keyboard Input Handler (Toggle UI, Camera Lock, TP To Target, Skip Target, Soru Silent)[cite: 7]
table.insert(State.Connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Config.Key_ToggleUI then
        Config.UI_Visible = not Config.UI_Visible
        MainWindow.Visible = Config.UI_Visible
    elseif input.KeyCode == Config.Key_CameraLock then
        Config.CameraLock = not Config.CameraLock
        if Config.CameraLock then
            State.LockedTarget = GetBestTarget()
            CamLockStroke.Color = Theme.HudRedText
            CamLockStroke.Transparency = 0
        else
            State.LockedTarget = nil
            CamLockStroke.Color = Color3.fromRGB(50, 52, 60)
            CamLockStroke.Transparency = 0.3
        end
    elseif input.KeyCode == Config.Key_TPToTarget then
        local target = State.LockedTarget or State.CurrentTarget or GetBestTarget()
        if target and IsPlayerAlive(target) then
            local myHrp = GetRootPart(LocalPlayer)
            local tHrp  = GetRootPart(target)
            if myHrp and tHrp then
                TryPortalBypass(tHrp.Position)
                myHrp.CFrame = tHrp.CFrame * CFrame.new(0, Config.TeleportOffsetY, Config.TeleportOffsetZ)
            end
        end
    elseif input.KeyCode == Config.Key_SkipTarget then
        local cur = State.LockedTarget or State.CurrentTarget
        if cur then
            State.BlacklistedTargets[cur.UserId] = true
            State.LockedTarget = nil
            State.CurrentTarget = nil
            Notify("Target Skipped", "Blacklisted " .. cur.Name, 2)
        end
    elseif input.KeyCode == Config.Key_SoruSilent and Config.SoruSilent then
        local target = State.LockedTarget or State.CurrentTarget
        if target and IsPlayerAlive(target) then
            local myHrp = GetRootPart(LocalPlayer)
            local tHrp  = GetRootPart(target)
            if myHrp and tHrp and (myHrp.Position - tHrp.Position).Magnitude <= Config.SoruSilentRange then
                myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3.5)
            end
        end
    end
end))

