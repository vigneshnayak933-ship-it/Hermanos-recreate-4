local function UpdateTargetVisualizers(targetPlr)
    local myHrp = GetRootPart(LocalPlayer)
    local tHrp  = targetPlr and GetRootPart(targetPlr)
    local tHum  = targetPlr and GetHumanoid(targetPlr)

    if not myHrp or not tHrp or not tHum or tHum.Health <= 0 then
        TargetSphereAdorn.Visible = false
        TargetSphereAdorn.Adornee = nil
        TargetRingAdorn.Visible = false
        TargetRingAdorn.Adornee = nil
        TargetLineAdorn.Visible = false
        TargetLineAdorn.Adornee = nil
        TargetHudFrame.Visible = false
        return
    end

    if Config.ShowTargetHUD then
        TargetHudFrame.Visible = true
        local dist = math.floor((myHrp.Position - tHrp.Position).Magnitude)
        TargetHudName.Text = string.format("%s [%dm]", targetPlr.DisplayName or targetPlr.Name, dist)
        local hpRatio = math.clamp(tHum.Health / math.max(tHum.MaxHealth, 1), 0, 1)
        TargetHudBarFill.Size = UDim2.fromScale(hpRatio, 1)
        TargetHudHpText.Text = string.format("%d / %d (%d%%)", math.floor(tHum.Health), math.floor(tHum.MaxHealth), math.floor(hpRatio * 100))
    else
        TargetHudFrame.Visible = false
    end

    if Config.DrawSphere then
        TargetSphereAdorn.Adornee = tHrp
        TargetSphereAdorn.Visible = true
    else
        TargetSphereAdorn.Visible = false
    end

    if Config.DrawRedLine then
        TargetRingAdorn.Adornee = tHrp
        TargetRingAdorn.Visible = true

        local dist = (myHrp.Position - tHrp.Position).Magnitude
        TargetLineAdorn.Adornee = Workspace.Terrain
        TargetLineAdorn.Size = Vector3.new(0.18, 0.18, dist)
        TargetLineAdorn.CFrame = CFrame.lookAt(myHrp.Position, tHrp.Position) * CFrame.new(0, 0, -dist * 0.5)
        TargetLineAdorn.Visible = true
    else
        TargetRingAdorn.Visible = false
        TargetLineAdorn.Visible = false
    end
end

