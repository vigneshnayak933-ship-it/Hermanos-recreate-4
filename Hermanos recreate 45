-- 2. Stepped: Physics Modifiers, Anti Stun, Walk On Water, Safe Retreat & Target Teleport
table.insert(State.Connections, RunService.Stepped:Connect(function(_, dt)
    local char = GetCharacter(LocalPlayer)
    local hum  = GetHumanoid(LocalPlayer)
    local hrp  = GetRootPart(LocalPlayer)
    if not char or not hum or not hrp or hum.Health <= 0 then return end

    -- Anti Stun: Clears Stun/Busy values and restores PlatformStand
    if Config.AntiStun then
        local stunObj = char:FindFirstChild("Stun") or hum:FindFirstChild("Stun")
        if stunObj and stunObj:IsA("ValueBase") and stunObj.Value ~= 0 then
            stunObj.Value = 0
        end
        local busyObj = char:FindFirstChild("Busy")
        if busyObj and busyObj:IsA("BoolValue") and busyObj.Value == true then
            busyObj.Value = false
        end
        if hum.PlatformStand then
            hum.PlatformStand = false
        end
    end

    -- Speed Boost & Speed Multiply CFrame translation
    if Config.SpeedBoost and hum.MoveDirection.Magnitude > 0 then
        local mult = math.clamp(Config.SpeedMultiply, 1, 50)
        local stepStuds = (mult * 0.085) * (dt * 60)
        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * stepStuds)
    end

    -- Jump Power override
    if Config.JumpPower then
        hum.UseJumpPower = true
        hum.JumpPower = Config.JumpPowerValue
    end

    -- Walk On Water: Adjusts workspace.Map["WaterBase-Plane"].Size
    if Config.WalkOnWater then
        local map = Workspace:FindFirstChild("Map")
        local waterPlane = map and map:FindFirstChild("WaterBase-Plane")
        if waterPlane and waterPlane.Size.Y < 110 then
            waterPlane.Size = Vector3.new(1000, 112, 1000)
        end
    end

    -- Infinite Energy Lock
    if Config.InfiniteEnergy then
        local energyObj = char:FindFirstChild("Energy")
        if energyObj and energyObj:IsA("ValueBase") then
            energyObj.Value = energyObj.MaxValue or 15000
        end
    end

    -- Auto Bounty Safe-Health Sky Retreat
    if Config.AutoBounty then
        if hum.Health <= Config.SafeHealth then
            State.IsSafeZoneRetreating = true
        elseif hum.Health >= math.min(Config.RecoverHealth, hum.MaxHealth * 0.85) then
            State.IsSafeZoneRetreating = false
        end

        if State.IsSafeZoneRetreating then
            hrp.CFrame = CFrame.new(hrp.Position.X, 4500, hrp.Position.Z)
            hrp.AssemblyLinearVelocity = Vector3.zero
            return
        end
    end

    -- Teleport Behide Target / Auto Bounty Pursuit
    local activeTarget = State.LockedTarget or State.CurrentTarget
    if (Config.TeleportBehideTarget or Config.AutoBounty) and activeTarget and IsPlayerAlive(activeTarget) then
        local tHrp = GetRootPart(activeTarget)
        if tHrp then
            local dist = (hrp.Position - tHrp.Position).Magnitude
            if dist <= Config.TeleportBehideRange then
                hrp.CFrame = tHrp.CFrame * CFrame.new(0, Config.TeleportOffsetY, Config.TeleportOffsetZ)
                hrp.AssemblyLinearVelocity = Vector3.zero
            elseif Config.AutoBounty then
                TryPortalBypass(tHrp.Position)
                local dir = (tHrp.Position - hrp.Position).Unit
                hrp.CFrame = CFrame.new(hrp.Position + dir * math.min(dist, Config.TweenSpeed * dt), tHrp.Position)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end
end))

