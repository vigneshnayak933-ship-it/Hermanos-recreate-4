local function GetCharacter(plr)
    plr = plr or LocalPlayer
    return plr and plr.Character
end

local function GetRootPart(plr)
    local char = GetCharacter(plr)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(plr)
    local char = GetCharacter(plr)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsPlayerAlive(plr)
    local hum = GetHumanoid(plr)
    local hrp = GetRootPart(plr)
    return (hum ~= nil and hrp ~= nil and hum.Health > 0)
end

local function FormatCompactNumber(n)
    n = tonumber(n) or 0
    if n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    end
    return tostring(math.floor(n))
end

-- Evaluates if a portal entrance via CommF_ brings the player closer to the destination
local function TryPortalBypass(targetPos)
    if not Config.BypassTP or not CommF_ then return false end
    local myHrp = GetRootPart(LocalPlayer)
    if not myHrp then return false end

    local activePortalMap = IsSea3 and PortalLocations.Sea3 or (IsSea2 and PortalLocations.Sea2 or (IsSea1 and PortalLocations.Sea1 or nil))
    if not activePortalMap then return false end

    local currentDist = (myHrp.Position - targetPos).Magnitude
    local bestPortalVec = nil
    local shortestDist = currentDist

    for _, portalVec in pairs(activePortalMap) do
        local distFromPortal = (portalVec - targetPos).Magnitude
        if (distFromPortal + 300) < shortestDist then
            shortestDist = distFromPortal
            bestPortalVec = portalVec
        end
    end

    if bestPortalVec then
        pcall(function()
            CommF_:InvokeServer("requestEntrance", bestPortalVec)
        end)
        return true
    end
    return false
end

local function SendKeyPress(keyCode, holdDuration)
    holdDuration = tonumber(holdDuration) or 0.05
    task.spawn(function()
        if VirtualInputManager then
            VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
            if holdDuration > 0 then
                task.wait(holdDuration)
            end
            VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
        end
    end)
end

-- Determines Blox Fruits PvP Status: 'InCombat', 'Disable Pvp', or 'Ready Pvp'
local function GetPlayerPvpState(plr)
    local char = GetCharacter(plr)
    if not char then return "Disable Pvp" end
    if char:FindFirstChildOfClass("ForceField") then
        return "Disable Pvp"
    end
    if char:GetAttribute("PvpDisabled") == true or plr:GetAttribute("PvpDisabled") == true then
        return "Disable Pvp"
    end
    local gui = plr:FindFirstChild("PlayerGui")
    local mainGui = gui and gui:FindFirstChild("Main")
    if mainGui and mainGui:FindFirstChild("PvpDisabled") and mainGui.PvpDisabled.Visible then
        return "Disable Pvp"
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local safeZones = worldOrigin and worldOrigin:FindFirstChild("SafeZones")
    if hrp and safeZones then
        for _, zone in ipairs(safeZones:GetChildren()) do
            if zone:IsA("BasePart") then
                local dist = (hrp.Position - zone.Position).Magnitude
                if dist <= (math.max(zone.Size.X, zone.Size.Z) * 0.55) then
                    return "Disable Pvp"
                end
            end
        end
    end

    if char:GetAttribute("InCombat") == true or plr:GetAttribute("InCombat") == true or char:FindFirstChild("InCombat") then
        return "InCombat"
    end
    return "Ready Pvp"
end

-- Detects Observation (Ken) Haki active state on target players
local function IsPlayerKenActive(plr)
    local char = GetCharacter(plr)
    if not char then return false end
    if char:GetAttribute("KenActive") == true or char:GetAttribute("Observation") == true then
        return true
    end
    if char:FindFirstChild("KenHaki") or char:FindFirstChild("Observation") then
        return true
    end
    return false
end

-- Computes FOV Circle center based on 'Middle', 'Mouse', or 'Target' mode[cite: 10]
local function GetFOVOrigin()
    local vpSize = Camera.ViewportSize
    if Config.FOVMode == "Mouse" then
        return UserInputService:GetMouseLocation()
    elseif Config.FOVMode == "Target" then
        local active = State.LockedTarget or State.CurrentTarget
        if active and IsPlayerAlive(active) then
            local tHrp = GetRootPart(active)
            if tHrp then
                local screenPos, onScreen = Camera:WorldToViewportPoint(tHrp.Position)
                if onScreen then
                    return Vector2.new(screenPos.X, screenPos.Y)
                end
            end
        end
    end
    return Vector2.new(vpSize.X * 0.5, vpSize.Y * 0.5)
end

-- Selects optimal PvP target inside Aim Range and FOV Circle[cite: 10]
local function GetBestTarget()
    if State.LockedTarget and IsPlayerAlive(State.LockedTarget) then
        local myHrp = GetRootPart(LocalPlayer)
        local tHrp = GetRootPart(State.LockedTarget)
        if myHrp and tHrp and (myHrp.Position - tHrp.Position).Magnitude <= Config.AimRange then
            return State.LockedTarget
        else
            State.LockedTarget = nil
        end
    end

    local myHrp = GetRootPart(LocalPlayer)
    if not myHrp then return nil end

    local fovOrigin = GetFOVOrigin()
    local maxRadius = Config.FOVSize * 0.5
    local bestCandidate = nil
    local shortestScreenDist = maxRadius

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not State.BlacklistedTargets[plr.UserId] and IsPlayerAlive(plr) then
            local isFriend = false
            if Config.SkipFriends then
                pcall(function() isFriend = LocalPlayer:IsFriendsWith(plr.UserId) end)
            end

            local alliedMarine = (LocalPlayer.Team and plr.Team and LocalPlayer.Team.Name == "Marines" and plr.Team.Name == "Marines")

            if not isFriend and not alliedMarine then
                local tChar = GetCharacter(plr)
                local hasV4 = tChar and (tChar:FindFirstChild("RaceTransformed") or tChar:GetAttribute("RaceTransformed") == true)
                local pvpState = GetPlayerPvpState(plr)

                if not (Config.SkipRaceV4 and hasV4) and pvpState ~= "Disable Pvp" then
                    local tHrp = GetRootPart(plr)
                    local worldDist = (myHrp.Position - tHrp.Position).Magnitude
                    if worldDist <= Config.AimRange then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(tHrp.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - fovOrigin).Magnitude
                            if screenDist <= shortestScreenDist then
                                shortestScreenDist = screenDist
                                bestCandidate = plr
                            end
                        end
                    end
                end
            end
        end
    end

    return bestCandidate
end

