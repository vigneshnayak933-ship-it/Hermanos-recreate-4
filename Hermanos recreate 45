-- [SECTION 12] 360° SILENT AIM METAMETHOD HOOK (__namecall MousePos)
-- ========================================================================================
-- Intercepts RemoteEvent:FireServer("MousePos", Vector3) for velocity-predicted aim[cite: 2]
if hookmetamethod then
    pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = { ... }

            if not checkcaller() and Config.SilentAim and (method == "FireServer" or method == "InvokeServer") then
                local target = State.LockedTarget or State.CurrentTarget
                if target and IsPlayerAlive(target) then
                    local tChar = GetCharacter(target)
                    local aimPart = (tChar and tChar:FindFirstChild(Config.AimPart)) or GetRootPart(target)
                    if aimPart and aimPart:IsA("BasePart") then
                        local predictedPos = aimPart.Position + (aimPart.AssemblyLinearVelocity * Config.PredictionFactor)
                        local remoteName = tostring(self.Name)

                        if remoteName == "RemoteEvent" or remoteName == "CommE" then
                            if args[1] == "MousePos" and typeof(args[2]) == "Vector3" then
                                args[2] = predictedPos
                                return oldNamecall(self, unpack(args))
                            elseif typeof(args[1]) == "Vector3" then
                                args[1] = predictedPos
                                return oldNamecall(self, unpack(args))
                            elseif typeof(args[1]) == "CFrame" then
                                args[1] = CFrame.new(predictedPos)
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end

            return oldNamecall(self, ...)
        end))
    end)
end

