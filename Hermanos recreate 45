-- [SECTION 10] BLOX FRUITS 8-FIELD REAL-TIME PLAYER ESP ENGINE
-- ========================================================================================
-- Renders Name, Health, Distance, Team, Level, Bounty, Ken Active, and Pvp State[cite: 2]
local function UpdateESP()
    local anyEspActive = (
        Config.ESP_Name or Config.ESP_Health or Config.ESP_Distance or
        Config.ESP_Team or Config.ESP_Level or Config.ESP_Bounty or
        Config.ESP_KenActive or Config.ESP_PvpState
    )

    if not anyEspActive then
        for _, gui in pairs(State.ESPObjects) do
            gui.Enabled = false
        end
        return
    end

    local myHrp = GetRootPart(LocalPlayer)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = GetCharacter(plr)
            local head = char and char:FindFirstChild("Head")
            local hum  = GetHumanoid(plr)
            local hrp  = GetRootPart(plr)

            if char and head and hum and hrp and hum.Health > 0 then
                local bGui = State.ESPObjects[plr.UserId]
                if not bGui then
                    bGui = Instance.new("BillboardGui")
                    bGui.Name = "HermanosESP_" .. tostring(plr.UserId)
                    bGui.AlwaysOnTop = true
                    bGui.Size = UDim2.fromOffset(230, 100)
                    bGui.StudsOffset = Vector3.new(0, 3.6, 0)
                    bGui.Parent = VisualsFolder

                    local textLbl = Instance.new("TextLabel")
                    textLbl.Name = "InfoLabel"
                    textLbl.Size = UDim2.fromScale(1, 1)
                    textLbl.BackgroundTransparency = 1
                    textLbl.Font = Enum.Font.GothamBold
                    textLbl.TextSize = 11
                    textLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    textLbl.TextStrokeTransparency = 0.22
                    textLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                    textLbl.RichText = true
                    textLbl.Parent = bGui

                    State.ESPObjects[plr.UserId] = bGui
                end

                bGui.Adornee = head
                bGui.Enabled = true

                local lines = {}
                if Config.ESP_Name or Config.ESP_Level then
                    local namePart = Config.ESP_Name and plr.Name or ""
                    local dataFolder = plr:FindFirstChild("Data")
                    local lvlObj = dataFolder and dataFolder:FindFirstChild("Level")
                    local lvlPart = (Config.ESP_Level and lvlObj) and ("[Lv." .. tostring(lvlObj.Value) .. "] ") or ""
                    table.insert(lines, string.format('<font color="#60A5FA">%s%s</font>', lvlPart, namePart))
                end

                if Config.ESP_Health or Config.ESP_Distance then
                    local hpStr = Config.ESP_Health and string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth)) or ""
                    local distVal = myHrp and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0
                    local distStr = Config.ESP_Distance and string.format("[%dm]", distVal) or ""
                    table.insert(lines, string.format('<font color="#4ADE80">%s %s</font>', hpStr, distStr))
                end

                if Config.ESP_Team or Config.ESP_Bounty then
